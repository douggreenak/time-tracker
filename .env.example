# Database connection string from Neon (PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# App settings
ENABLE_DEMO_DATA=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
