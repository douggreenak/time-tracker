# ── Database ────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty for local use: the app runs an embedded Postgres that saves to ./.data/pglite
# (survives restarts; delete the folder to start over). For production set a Neon connection string:
# postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=

# ── Sign-in ─────────────────────────────────────────────────────────────
# Secret used to sign login cookies. Optional: if unset it is derived from DATABASE_URL, or (locally)
# generated once into ./.data/auth-secret. Set it explicitly on any hosted deployment.
AUTH_SECRET=

# ── Sample data ─────────────────────────────────────────────────────────
# true  = an empty database is filled once with sample people/customers/entries
#         (everyone's password is demo1234; use the banner's "Clear sample data" button to remove it)
# false = start blank — the first visit asks you to create an admin account
ENABLE_DEMO_DATA=true
