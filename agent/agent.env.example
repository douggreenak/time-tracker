# Copy to /etc/timetrack-agent.env (chmod 600) and fill in.
# The web address of your TimeTrack site:
TT_URL=https://timetracker.example.com
# Make this in the web app: Admin → Backup agent → "Make a new agent token"
TT_TOKEN=ttagent_...
# Password for the SMB user chosen in the Admin page (it is never sent to the web app):
SMB_PASSWORD=
